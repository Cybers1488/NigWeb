<widgets:HotbarGui
    xmlns="https://spacestation14.io"
    xmlns:inventory="clr-namespace:Content.Client.UserInterface.Systems.Inventory.Controls"
    xmlns:hands="clr-namespace:Content.Client.UserInterface.Systems.Hands.Controls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Hotbar.Widgets"
    Name="HotbarInterface"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Orientation="Horizontal">
    <BoxContainer Orientation="Horizontal" Name="Hotbar" HorizontalAlignment="Left" VerticalAlignment="Top" SeparationOverride="0">
        <hands:HandsContainer
            Name="HandContainer"
            Access="Public"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            HorizontalExpand="False"
            ColumnLimit="3" HSeparationOverride="0" VSeparationOverride="0"/>
    </BoxContainer>
    <BoxContainer Name="SingleStorageContainer"
                  Access="Public"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="15 0 0 0"
                  Visible="False">
    </BoxContainer>
    <BoxContainer Name="DoubleStorageContainer"
                  Access="Public"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="15 0 0 0"
                  Visible="False">
        <BoxContainer Name="LeftStorageContainer"
                      Access="Public"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
        </BoxContainer>
        <BoxContainer Name="RightStorageContainer"
                      Access="Public"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="10 0 0 0">
        </BoxContainer>
    </BoxContainer>
    <Control Visible="False">
        <inventory:ItemSlotButtonContainer Name="SecondHotbar" SlotGroup="SecondHotbar"/>
        <inventory:ItemSlotButtonContainer Name="MainHotbar" SlotGroup="MainHotbar"/>
        <inventory:ItemStatusPanel Name="StatusPanelRight"/>
        <inventory:ItemStatusPanel Name="StatusPanelLeft"/>
    </Control>
</widgets:HotbarGui>

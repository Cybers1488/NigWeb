<widgets:InventoryGui
    xmlns="https://spacestation14.io"
    xmlns:inventory="clr-namespace:Content.Client.UserInterface.Systems.Inventory.Controls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Inventory.Widgets"
    Name="InventoryInterface"
    HorizontalAlignment="Left"
    VerticalAlignment="Stretch"
    HorizontalExpand="False"
    VerticalExpand="True"
    Visible="True">
    <PanelContainer Name="LeftHudPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalExpand="True" VerticalExpand="True">
        <inventory:ItemSlotButtonContainer
            Name="InventoryHotbar"
            Access="Public"
            Visible="True"
            MaxColumns="3"
            SlotGroup="Default"
            ExpandBackwards="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            HSeparationOverride="0"
            VSeparationOverride="0"
        />
        <BoxContainer Name="BottomControls"
                      Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      Margin="0 0 0 0">
            <TextureButton Name="CombatButton"
                           Access="Public"
                           MouseFilter="Stop"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" />
            <Control Name="BottomSpacer"
                     MouseFilter="Ignore" />
            <TextureButton Name="SprintButton"
                           Access="Public"
                           MouseFilter="Stop"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" />
        </BoxContainer>
    </PanelContainer>
</widgets:InventoryGui>

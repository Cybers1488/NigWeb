// SPDX-License-Identifier: AGPL-3.0-or-later
uniform sampler2D SCREEN_TEXTURE;
uniform highp float intensity;

highp vec3 hsv2rgb_apoc(highp vec3 c) {
    highp vec3 rgb = clamp(abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
    rgb = rgb * rgb * (3.0 - 2.0 * rgb);
    return c.z * mix(vec3(1.0), rgb, c.y);
}

void fragment() {
    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;

    if (intensity <= 0.001) {
        COLOR = zTextureSpec(SCREEN_TEXTURE, coord);
        return;
    }

    highp float t = TIME * 2.8;

    // 1. Hotline Miami 2 liquid wave distortion (breathing hallucinations)
    highp vec2 wave = vec2(
        sin(coord.y * 14.0 + t * 1.4) + sin(coord.x * 9.0 + t * 0.7),
        cos(coord.x * 14.0 + t * 1.1) + cos(coord.y * 10.0 + t * 0.8)
    ) * (0.0028 * intensity);

    highp vec2 wavedCoord = coord + wave;

    // 2. Chromatic aberration (RGB channel split) pulsing
    highp float chromPulse = (0.0045 + 0.0025 * sin(t * 2.0)) * intensity;
    highp vec2 chromDir = vec2(cos(t * 0.7), sin(t * 0.7)) * chromPulse;

    highp vec4 baseColor;
    baseColor.r = zTextureSpec(SCREEN_TEXTURE, wavedCoord + chromDir).r;
    baseColor.g = zTextureSpec(SCREEN_TEXTURE, wavedCoord).g;
    baseColor.b = zTextureSpec(SCREEN_TEXTURE, wavedCoord - chromDir).b;
    baseColor.a = 1.0;

    // 3. Psychedelic neon Miami color wash (cycling through magenta, purple, cyan, yellow)
    highp float hue = mod(TIME * 0.16, 1.0);
    highp vec3 neon = hsv2rgb_apoc(vec3(hue, 0.85, 1.0));
    highp vec3 tripColor = mix(baseColor.rgb, baseColor.rgb * (neon * 1.5 + 0.3), 0.32 * intensity);

    // 4. Subtle scanline CRT ripple
    highp float scan = 0.95 + 0.05 * sin(FRAGCOORD.y * 1.8 + TIME * 8.0);
    tripColor *= scan;

    COLOR = mix(zTextureSpec(SCREEN_TEXTURE, coord), vec4(tripColor, 1.0), intensity);
}
